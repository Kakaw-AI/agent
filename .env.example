# ── Infisical bootstrap ──────────────────────────────────────────────────────
INFISICAL_SITE_URL=https://hush.gitnasr.com
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_ENVIRONMENT=
INFISICAL_SECRET_PATH=/

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# ── OpenTelemetry (traces + metrics + logs) ──────────────────────────────────
# OFF unless OTEL_EXPORTER_OTLP_ENDPOINT is set. Exporters append
# /v1/traces, /v1/metrics, /v1/logs. Point at the Alloy OTLP gateway.
OTEL_EXPORTER_OTLP_ENDPOINT=https://alloy.gitnasr.com
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=kakaw-agent
# Optional auth header for the gateway, e.g. "Authorization=Basic <base64>".
OTEL_EXPORTER_OTLP_HEADERS=

# ── Managed by Infisical in prod/dev (local fallback) ────────────────────────
AGENT_SHARED_SECRET=

# ── Query limits and network guard (non-secret) ──────────────────────────────
# Ceiling for one generated query against a user's database, in milliseconds.
QUERY_TIMEOUT_MS=30000
# A model call reviews each result against the question before it is shown,
# and can send it back for one rewrite. Costs one extra call per answer.
VERIFY_RESULTS=true
# In production the agent refuses to connect to private or internal addresses
# (a user's Postgres host or custom LLM endpoint). Set to true only for a
# self-hosted install that keeps those on a private network.
ALLOW_PRIVATE_HOSTS=

# ── Result cache tunables (non-secret; safe to keep local) ───────────────────
RESULT_CACHE_MAX=200
RESULT_CACHE_TTL_MS=900000
RESULT_CACHE_STRICT=false

# ── Latitude (LLM tracing) ───────────────────────────────────────────────────
# OFF unless LATITUDE_API_KEY is set. Composes with the OTLP export above:
# every span still goes to Alloy, Latitude additionally receives the LLM ones.
#
# Read at PRELOAD time (telemetry.js is imported before server.js), which runs
# before Infisical secrets are fetched — so these must be real process env vars
# in deployment, exactly like the OTEL_* vars. Infisical will not work here.
#
# LATITUDE_API_KEY: Latitude → Settings → API Keys.
# LATITUDE_PROJECT_SLUG: short slug in the project sidebar, not the display name.
LATITUDE_API_KEY=lat-xxxxxxxxxxxxxxxxxxxx
LATITUDE_PROJECT_SLUG=your-project-slug

# ── LangSmith (LLM tracing) ──────────────────────────────────────────────────
# No code needed: @langchain/core already bundles the langsmith client and
# reads these at run time, so Infisical works for them. OFF unless set to true.
# Traces include prompts, schema and query results; in staging or production
# trace a sample only. Each run carries the question, conversation and model as
# metadata, and an "outcome" feedback score (0 = failed) to filter on.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxx
# LANGSMITH_PROJECT=kakaw-agent
# LANGSMITH_TRACING_SAMPLING_RATE=0.2   # share of runs traced; omit for all
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU accounts only

# Web search through our self-hosted Firecrawl (v2 API). Leave unset to turn
# web search off; the agent then never offers it to the model.
FIRECRAWL_API_URL=https://fc.gitnasr.com
FIRECRAWL_API_KEY=
