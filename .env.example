# ── Infisical bootstrap ──────────────────────────────────────────────────────
INFISICAL_SITE_URL=https://hush.gitnasr.com
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_ENVIRONMENT=
INFISICAL_SECRET_PATH=/

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# ── OpenTelemetry (traces + metrics + logs) ──────────────────────────────────
# OFF unless OTEL_EXPORTER_OTLP_ENDPOINT is set. Exporters append
# /v1/traces, /v1/metrics, /v1/logs. Point at the Alloy OTLP gateway.
OTEL_EXPORTER_OTLP_ENDPOINT=https://alloy.gitnasr.com
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=kakaw-agent
# Optional auth header for the gateway, e.g. "Authorization=Basic <base64>".
OTEL_EXPORTER_OTLP_HEADERS=

# ── Managed by Infisical in prod/dev (local fallback) ────────────────────────
AGENT_SHARED_SECRET=

# ── Result cache tunables (non-secret; safe to keep local) ───────────────────
RESULT_CACHE_MAX=200
RESULT_CACHE_TTL_MS=900000
RESULT_CACHE_STRICT=false

# ── Latitude (LLM tracing) ───────────────────────────────────────────────────
# OFF unless LATITUDE_API_KEY is set. Composes with the OTLP export above:
# every span still goes to Alloy, Latitude additionally receives the LLM ones.
#
# Read at PRELOAD time (telemetry.js is imported before server.js), which runs
# before Infisical secrets are fetched — so these must be real process env vars
# in deployment, exactly like the OTEL_* vars. Infisical will not work here.
#
# LATITUDE_API_KEY: Latitude → Settings → API Keys.
# LATITUDE_PROJECT_SLUG: short slug in the project sidebar, not the display name.
LATITUDE_API_KEY=lat-xxxxxxxxxxxxxxxxxxxx
LATITUDE_PROJECT_SLUG=your-project-slug
